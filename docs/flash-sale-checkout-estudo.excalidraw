      "id": "_SpmKEiQ-JkO_zckSStR7",
      "type": "text",
      "x": 408.5,
      "y": 3410,
      "width": 823.7,
      "height": 20,
      "text": "Ideia: o BANCO faz a conta e a conferência num único comando. Não existe janela entre ler e gravar.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "Ideia: o BANCO faz a conta e a conferência num único comando. Não existe janela entre ler e gravar.",
