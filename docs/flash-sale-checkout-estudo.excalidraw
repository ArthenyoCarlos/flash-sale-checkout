      "width": 784,
      "height": 352.5,
      "index": "ar",
      "created": 1794751464224
    },
    {
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "SduF-auNehgqfd50KDuOT"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 425867683,
      "version": 5,
      "versionNonce": 10854733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "N7SE-eCAK6DUi7WVG6mgO",
      "type": "text",
      "x": 414.5,
      "y": 3448,
      "width": 848.4,
      "height": 332.5,
      "text": "// ProdutoRepository.java\n@Modifying(clearAutomatically = true)\n@Query(\"\"\"\n    UPDATE Produto p SET p.estoque = p.estoque - 1, p.versao = p.versao + 1\n     WHERE p.id = :id AND p.estoque > 0\n    \"\"\")\nint baixarEstoqueSeDisponivel(@Param(\"id\") Long id);   // 1 = vendeu, 0 = não vendeu\n\n// PedidoService.realizarCompra\nint linhasAlteradas = produtoRepository.baixarEstoqueSeDisponivel(produtoId);\nif (linhasAlteradas == 0) {\n    if (!produtoRepository.existsById(produtoId)) throw new ObjetoNaoEncontradoException(...); // 404\n    throw new EstoqueInsuficienteException(...);                                            // 409\n}\nProduto produto = produtoRepository.getReferenceById(produtoId);  // \"dublê\", sem SELECT\npedidoRepository.save(new Pedido(produto));\n\n-- SQL gerado: a conta é do banco\nupdate produto set estoque=(estoque-1), versao=(versao+1) where id=? and estoque>0",
      "fontSize": 12.5,
      "fontFamily": 3,
      "originalText": "// ProdutoRepository.java\n@Modifying(clearAutomatically = true)\n@Query(\"\"\"\n    UPDATE Produto p SET p.estoque = p.estoque - 1, p.versao = p.versao + 1\n     WHERE p.id = :id AND p.estoque > 0\n    \"\"\")\nint baixarEstoqueSeDisponivel(@Param(\"id\") Long id);   // 1 = vendeu, 0 = não vendeu\n\n// PedidoService.realizarCompra\nint linhasAlteradas = produtoRepository.baixarEstoqueSeDisponivel(produtoId);\nif (linhasAlteradas == 0) {\n    if (!produtoRepository.existsById(produtoId)) throw new ObjetoNaoEncontradoException(...); // 404\n    throw new EstoqueInsuficienteException(...);                                            // 409\n}\nProduto produto = produtoRepository.getReferenceById(produtoId);  // \"dublê\", sem SELECT\npedidoRepository.save(new Pedido(produto));\n\n-- SQL gerado: a conta é do banco\nupdate produto set estoque=(estoque-1), versao=(versao+1) where id=? and estoque>0",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "as",
      "created": 1794751464224,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "SduF-auNehgqfd50KDuOT"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1892748611,
      "version": 5,
      "versionNonce": 2130290179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "i-YLGqFUcD9jro0QMml8K",
      "type": "text",
      "x": 408.5,
      "y": 3806.5,
      "width": 765.4,
      "height": 80,
      "text": "• Exceção não é retorno: o throw interrompe o método e o handler responde 404/409.\n• O \"0\" tem dois significados; existsById separa \"não existe\" de \"esgotou\" sem criar janela.\n• O UPDATE direto passa por fora do Hibernate: incrementar a versão no próprio comando.\n• A CHECK (estoque >= 0) volta a ser rede de segurança contra um UPDATE escrito errado.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "• Exceção não é retorno: o throw interrompe o método e o handler responde 404/409.\n• O \"0\" tem dois significados; existsById separa \"não existe\" de \"esgotou\" sem criar janela.\n• O UPDATE direto passa por fora do Hibernate: incrementar a versão no próprio comando.\n• A CHECK (estoque >= 0) volta a ser rede de segurança contra um UPDATE escrito errado.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "at",
      "created": 1794751464225,
      "labelPosition": null,
      "baseFontSize": null
    },
