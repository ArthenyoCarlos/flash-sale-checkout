      "id": "59MgrxphYftu0_AJAyFZs",
      "type": "text",
      "x": 414.5,
      "y": 2837.5,
      "width": 663.6,
      "height": 157.5,
      "text": "-- V3__adicionar_versao_produto.sql (nunca editar a V1!)\nALTER TABLE produto ADD COLUMN versao INT NOT NULL DEFAULT 0;\n\n// Produto.java\n@Version                 // jakarta.persistence.Version (não o do Spring Data!)\nprivate Integer versao;  // sem \"= 0\": versão null = entidade nova\n\n-- SQL gerado\nupdate produto set estoque=?, versao=? where id=? and versao=?",
      "fontSize": 14,
      "fontFamily": 3,
      "originalText": "-- V3__adicionar_versao_produto.sql (nunca editar a V1!)\nALTER TABLE produto ADD COLUMN versao INT NOT NULL DEFAULT 0;\n\n// Produto.java\n@Version                 // jakarta.persistence.Version (não o do Spring Data!)\nprivate Integer versao;  // sem \"= 0\": versão null = entidade nova\n\n-- SQL gerado\nupdate produto set estoque=?, versao=? where id=? and versao=?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aU",
      "created": 1794751464224,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
