      "type": "text",
      "x": -455.5,
      "y": 2837.5,
      "width": 588,
      "height": 227.5,
      "text": "@Transactional\npublic PedidoResponseDTO realizarCompra(Long produtoId) {\n    Produto produto = produtoRepository.findById(produtoId)\n            .orElseThrow(() -> new ObjetoNaoEncontradoException(...));\n    produto.baixarEstoque(1);          // a conta é feita no Java\n    produtoRepository.save(produto);\n    Pedido pedido = new Pedido(produto);\n    pedidoRepository.save(pedido);\n    return new PedidoResponseDTO(pedido);\n}\n\n-- SQL gerado: o valor já vem calculado\nupdate produto set estoque=77 where id=?",
      "fontSize": 14,
      "fontFamily": 3,
      "originalText": "@Transactional\npublic PedidoResponseDTO realizarCompra(Long produtoId) {\n    Produto produto = produtoRepository.findById(produtoId)\n            .orElseThrow(() -> new ObjetoNaoEncontradoException(...));\n    produto.baixarEstoque(1);          // a conta é feita no Java\n    produtoRepository.save(produto);\n    Pedido pedido = new Pedido(produto);\n    pedidoRepository.save(pedido);\n    return new PedidoResponseDTO(pedido);\n}\n\n-- SQL gerado: o valor já vem calculado\nupdate produto set estoque=77 where id=?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
