    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "VtltWOfDY4Jz909BJfgae"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1175544675,
      "version": 5,
      "versionNonce": 1941809261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "05HcJZ5ggnXKVJmCjziL4",
      "type": "text",
      "x": 1278.5,
      "y": 3410,
      "width": 740.5,
      "height": 60,
      "text": "HOT ROW: quando todo mundo disputa a MESMA linha, ela só pode ser alterada por uma compra\nde cada vez. Pessimista e update atômico empataram porque esbarram no mesmo gargalo.\nTrocar a forma de trancar não muda o fato de que tem que trancar.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "HOT ROW: quando todo mundo disputa a MESMA linha, ela só pode ser alterada por uma compra\nde cada vez. Pessimista e update atômico empataram porque esbarram no mesmo gargalo.\nTrocar a forma de trancar não muda o fato de que tem que trancar.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ay",
      "created": 1794751464225,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "VtltWOfDY4Jz909BJfgae"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 427097859,
      "version": 5,
      "versionNonce": 1856053475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "18n0JAK6LVjqn9-aWCBxh",
      "type": "text",
      "x": 1278.5,
      "y": 3482,
      "width": 682.2,
      "height": 40,
      "text": "CORREÇÃO CUSTA DESEMPENHO: a versão errada (etapa 1) era a mais rápida: 150 req/s.\nToda versão correta ficou entre 59 e 90 req/s.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "CORREÇÃO CUSTA DESEMPENHO: a versão errada (etapa 1) era a mais rápida: 150 req/s.\nToda versão correta ficou entre 59 e 90 req/s.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "az",
      "created": 1794751464225,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "VtltWOfDY4Jz909BJfgae"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1629759139,
      "version": 5,
      "versionNonce": 539497165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "sqgUImBfKMx2_XAT9yrRk",
      "type": "text",
      "x": 1278.5,
      "y": 3534,
      "width": 707.2,
      "height": 60,
      "text": "POOL (HikariCP): protege o banco, não atende usuários. Lei de Little:\nconexões ocupadas = requisições/s × tempo no banco. Soma dos pools < max_connections.\nNo hot row, aumentar o pool só coloca mais gente esperando parada.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "POOL (HikariCP): protege o banco, não atende usuários. Lei de Little:\nconexões ocupadas = requisições/s × tempo no banco. Soma dos pools < max_connections.\nNo hot row, aumentar o pool só coloca mais gente esperando parada.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b00",
