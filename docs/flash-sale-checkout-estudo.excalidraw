      "seed": 100122691,
      "version": 5,
      "versionNonce": 1408958339,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "x0O2MhUSzQNAJdewm8s_m",
      "type": "text",
      "x": -455.5,
      "y": 3468,
      "width": 705.6,
      "height": 122.5,
      "text": "// ProdutoRepository.java\n@Lock(LockModeType.PESSIMISTIC_WRITE)\n@Query(\"SELECT p FROM Produto p WHERE p.id = :id\")     // JPQL: entidade, não tabela\nOptional<Produto> buscarPorIdParaCompra(@Param(\"id\") Long id);\n\n-- SQL gerado (Postgres)\nselect ... from produto p1_0 where p1_0.id=? for no key update of p1_0",
      "fontSize": 14,
      "fontFamily": 3,
      "originalText": "// ProdutoRepository.java\n@Lock(LockModeType.PESSIMISTIC_WRITE)\n@Query(\"SELECT p FROM Produto p WHERE p.id = :id\")     // JPQL: entidade, não tabela\nOptional<Produto> buscarPorIdParaCompra(@Param(\"id\") Long id);\n\n-- SQL gerado (Postgres)\nselect ... from produto p1_0 where p1_0.id=? for no key update of p1_0",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "al",
      "created": 1794751464224,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "6XTRnByzjyfSgqryCYKcz"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1245495267,
      "version": 5,
      "versionNonce": 1020849709,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794751464226,
      "link": null,
      "locked": false,
      "id": "G5rwXJs3iOEOt_lQOlNGV",
      "type": "text",
      "x": -461.5,
      "y": 3616.5,
      "width": 798.7,
      "height": 80,
      "text": "• O lock dura até o commit: só funciona dentro de @Transactional.\n• FOR NO KEY UPDATE: tranca quem quer alterar, mas deixa a chave estrangeira do pedido conferir.\n• Sem conflito de versão → retry não é necessário. Ninguém recebe \"tente novamente\" falso.\n• Gargalo é o LOCK, não o pool: 9 das 10 conexões ficam paradas esperando a fila.",
      "fontSize": 16,
      "fontFamily": 2,
      "originalText": "• O lock dura até o commit: só funciona dentro de @Transactional.\n• FOR NO KEY UPDATE: tranca quem quer alterar, mas deixa a chave estrangeira do pedido conferir.\n• Sem conflito de versão → retry não é necessário. Ninguém recebe \"tente novamente\" falso.\n• Gargalo é o LOCK, não o pool: 9 das 10 conexões ficam paradas esperando a fila.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "am",
      "created": 1794751464224,
      "labelPosition": null,
      "baseFontSize": null
