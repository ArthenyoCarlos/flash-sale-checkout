      "isDeleted": false,
      "boundElements": null,
      "updated": 1794745462145,
      "created": 1794745221248,
      "link": null,
      "locked": false,
      "text": "Problema: Sistemas que são bem arquitetado, ver esse caso se torna um grande\nproblema. O que acontece, digamos que 200 pessoas cliquem em comprar so que eu\nso tenho 100 PS5 sem uma arquitetura correta, o sistema pode criar 200 vendas\ndo PS5 sendo que so tem 100 e sem da nenhum erro",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problema: Sistemas que são bem arquitetado, ver esse caso se torna um grande problema. O que acontece, digamos que 200 pessoas cliquem em comprar so que eu so tenho 100 PS5 sem uma arquitetura correta, o sistema pode criar 200 vendas do PS5 sendo que so tem 100 e sem da nenhum erro",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
